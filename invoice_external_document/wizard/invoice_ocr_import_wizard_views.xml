<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_ocr_import_wizard_form" model="ir.ui.view">
        <field name="name">invoice.ocr.import.wizard.form</field>
        <field name="model">invoice.ocr.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import External Invoice via OCR">
                <sheet>
                    <group invisible="state != 'upload'">
                        <field name="company_id" invisible="1"/>
                        <field name="target_move_type" readonly="1"/>
                        <field name="config_id" required="1" domain="[('active', '=', True), ('company_id', '=', company_id), ('default_move_type', '=', target_move_type)]"/>
                        <field name="file_data" filename="filename" required="1"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <notebook invisible="state != 'preview'">
                        <page string="Normalized JSON">
                            <field name="normalized_json" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Raw Response">
                            <field name="response_json" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_extract" type="object" string="Extract" class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'preview'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
