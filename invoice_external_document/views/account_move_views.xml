<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_invoice_ocr_import_wizard" model="ir.actions.act_window">
        <field name="name">Import External Invoice via OCR</field>
        <field name="res_model">invoice.ocr.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_move_form_external_ocr" model="ir.ui.view">
        <field name="name">account.move.form.external.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_external_ocr_import" type="object" string="Import OCR" class="btn-primary" invisible="state != 'draft' or move_type not in ('out_invoice', 'in_invoice')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="External OCR">
                    <group>
                        <field name="is_created_from_external_ocr" readonly="1"/>
                        <field name="external_ocr_source_filename" readonly="1"/>
                        <field name="external_ocr_attachment_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="external_ocr_json" readonly="1" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
