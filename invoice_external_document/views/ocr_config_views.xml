<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_ocr_config_tree" model="ir.ui.view">
        <field name="name">invoice.ocr.config.list</field>
        <field name="model">invoice.ocr.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="default_move_type"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="company_id"/>
                <field name="active"/>

            </list>
        </field>
    </record>
    <record id="view_invoice_ocr_config_form" model="ir.ui.view">
        <field name="name">invoice.ocr.config.form</field>
        <field name="model">invoice.ocr.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="provider"/>
                            <field name="api_key" password="True"/>
                            <field name="model_name"/>
                            <field name="endpoint_url"/>
                        </group>
                        <group string="Odoo Matching">
                            <field name="default_move_type"/>
                            <field name="create_missing_partner"/>
                            <field name="create_missing_product"/>
                            <field name="default_tax_id"/>
                            <field name="max_file_size_mb"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_invoice_ocr_config" model="ir.actions.act_window">
        <field name="name">Invoice OCR Configuration</field>
        <field name="res_model">invoice.ocr.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_invoice_ocr_root" name="External OCR" parent="account.menu_finance_configuration" sequence="90"/>
    <menuitem id="menu_invoice_ocr_config" name="OCR Configuration" parent="menu_invoice_ocr_root" action="action_invoice_ocr_config" sequence="10"/>
</odoo>
