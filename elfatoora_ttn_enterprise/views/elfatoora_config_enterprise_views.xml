<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elfatoora_config_form_enterprise" model="ir.ui.view">
        <field name="name">digiit_model_elfatoora.config.form.enterprise</field>
        <field name="model">digiit_model_elfatoora.config</field>
        <field name="inherit_id" ref="elfatoora_ttn_base.view_elfatoora_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Enterprise-ID" invisible="not enable_enterprise">
                    <group string="Enterprise-ID Certificate">
                        <field name="enterprise_p12_file"
                               filename="enterprise_p12_filename"
                               required="enable_enterprise"/>
                        <field name="enterprise_p12_filename" invisible="1"/>
                        <field name="enterprise_p12_password"
                               password="True"
                               placeholder="Certificate password"
                               required="enable_enterprise"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
